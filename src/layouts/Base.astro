---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  section?: 'writing' | 'about';
  draft?: boolean;
  articleDate?: Date;
}
const { title, description = site.description, section = 'writing', draft = false, articleDate } = Astro.props;
const pageTitle = title ? `${title} · ${site.author}` : `${site.title} · ${site.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#f8f7f3" />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.author} — ${site.title}`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:site_name" content={`${site.author} — ${site.title}`} />
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="site-name" href="/">{site.author}</a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={section === 'writing' ? 'page' : undefined}>Writing</a>
        <a href="/about/" aria-current={section === 'about' ? 'page' : undefined}>About</a>
        <a class="external-link" href={site.github}>GitHub <Arrow direction="up-right" size={18} /></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <span>© {new Date().getFullYear()} {site.author}</span>
      <div><a href="/rss.xml">RSS</a><a href="https://astro.build">Built with Astro</a></div>
    </footer>
  </body>
</html>
