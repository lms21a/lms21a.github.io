---
import ResearchPlot from './ResearchPlot.astro';
import desktop from '../assets/research/flash-cispo-comparison.png';
import mobile from '../assets/research/flash-cispo-comparison-mobile.png';
import data from '../data/flash-cispo-comparison.json';
const percent = (value: number) => `${(value * 100).toFixed(2)}%`;
const [flash, cispo] = data.series;
---
<details class="algorithm-comparison" data-algorithm-comparison>
  <summary><span class="note-kicker">An earlier algorithm check</span><span class="note-title">FlashREINFORCE and CISPO</span><span class="note-description">Compare the runs at the same generated-response budget.</span></summary>
  <figure>
    <ResearchPlot desktop={desktop} mobile={mobile} alt="Six matched generated-rollout budgets in a separate earlier Futoshiki experiment. FlashREINFORCE finishes at 46.88% pass@1 and CISPO at 21.88%, after 58,752 generated training responses each." />
    <figcaption>Separate September 2026 branch: shared starting weights, a 10,240-puzzle bank, and a binary final-answer verifier. One seed; 32 validation puzzles × 8 attempts, with 4,096 tokens. CISPO’s rejected and surplus training responses count toward the horizontal axis.</figcaption>
    <div class="final-budgets">
      {data.series.map(series => <div><strong>{series.algorithm}</strong><p>{series.updates} optimizer updates<br />{series.selected_rollouts.toLocaleString('en-US')} responses trained on<br />{(series.points.at(-1)!.training_generated_tokens / 1e6).toFixed(2)}M generated tokens</p></div>)}
    </div>
    <details class="exact-values">
      <summary>Exact scores at each budget</summary>
      <div class="table-wrap"><table>
        <thead><tr><th scope="col">Generated rollouts</th><th scope="col">Flash</th><th scope="col">CISPO</th></tr></thead>
        <tbody>{flash.points.map((point, index) => <tr><th scope="row">{point.training_rollouts.toLocaleString('en-US')}</th><td>{percent(point.pass_at_1)}<small>{point.correct_completions}/{point.examples}</small></td><td>{percent(cispo.points[index].pass_at_1)}<small>{cispo.points[index].correct_completions}/{cispo.points[index].examples}</small></td></tr>)}</tbody>
      </table></div>
    </details>
    <p class="comparison-limit">Updates, prompt grouping, retained responses, and token totals differ. These measurements compare the two training recipes on this small validation panel.</p>
  </figure>
</details>
<style>
  .algorithm-comparison { border: 1px solid var(--rule); border-radius: 4px; margin-block: 30px; background: #f1f1e8; }
  .algorithm-comparison > summary { padding: 20px 24px; cursor: pointer; list-style-position: inside; color: var(--green); }
  .note-kicker { font-size: 10px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; }
  .note-title { display: block; font-family: var(--serif); font-size: 28px; font-weight: 550; line-height: 1.2; color: var(--ink); margin-top: 9px; }
  .note-description { display: block; font-size: 12px; line-height: 1.7; color: var(--muted); margin-top: 8px; }
  .algorithm-comparison > figure { margin: 0; padding: 0 24px 23px; }
  .algorithm-comparison figcaption { color: var(--muted); font-size: 11px; line-height: 1.7; text-align: left; margin: 10px 0 0; }
  .final-budgets { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; margin-block: 22px; border-block: 1px solid var(--rule); padding-block: 17px; }
  .final-budgets strong { font-size: 12px; color: var(--green); }
  .final-budgets p { font-size: 12px; line-height: 1.8; color: var(--muted); margin: 7px 0 0; }
  .exact-values summary { cursor: pointer; color: var(--green); font-size: 12px; line-height: 1.7; }
  summary:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
  .table-wrap { overflow-x: auto; }
  .exact-values table { display: table; width: 100%; border-collapse: collapse; font-size: 12px; line-height: 1.6; margin-top: 12px; }
  .exact-values th, .exact-values td { min-width: 0; padding: 9px 6px; border-bottom: 1px solid var(--rule); text-align: right; }
  .exact-values th:first-child { text-align: left; }
  .exact-values th { font-weight: 500; }
  .exact-values small { display: block; color: var(--muted); font-size: 10px; margin-top: 3px; }
  .comparison-limit { font-size: 11px; line-height: 1.7; color: var(--muted); margin: 17px 0 0; }
  @media (max-width: 620px) {
    .algorithm-comparison > summary { padding: 19px 16px; }
    .note-title { font-size: 25px; }
    .note-description { font-size: 13px; }
    .algorithm-comparison > figure { padding: 0 15px 20px; }
    .final-budgets { gap: 12px; }
    .exact-values summary { min-height: 44px; padding-block: 10px; }
    .exact-values table { font-size: 11px; }
  }
</style>
