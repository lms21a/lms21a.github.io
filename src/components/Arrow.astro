---
interface Props {
  direction?: 'right' | 'left' | 'up-right';
  size?: number;
}
const { direction = 'right', size = 24 } = Astro.props;
const rotations = { right: 0, left: 180, 'up-right': -45 };
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style={`transform: rotate(${rotations[direction]}deg)`}>
  <path d="M4 12h16M13 5l7 7-7 7" />
</svg>
